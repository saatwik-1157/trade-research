# Copy to .env and edit. .env is gitignored. Nothing here is read by tools/;
# the research toolkit keeps using SEC_USER_AGENT and TV_WEBHOOK_SECRET.

# --- Mode. These decide whether money can move. Defaults fail closed. ---
ENVIRONMENT=development          # development | test | production
TRADING_MODE=paper               # paper (simulator) | demo (MT5 demo account) | live (refused)
LIVE_TRADING=false               # must be true for live; still refused until every gate exists

# --- Backend ---
LOG_LEVEL=INFO
LOG_JSON=true
# 127.0.0.1 rather than localhost: Docker publishes on IPv4 only and Windows
# resolves localhost to ::1 first, which hangs until the timeout.
DATABASE_URL=postgresql+asyncpg://trade:trade@127.0.0.1:5440/trade
REDIS_URL=redis://127.0.0.1:6390/0
API_HOST=127.0.0.1
API_PORT=8000

# --- Authentication (L04) ---
SESSION_COOKIE_NAME=tr_session
SESSION_TTL_HOURS=12
# COOKIE_SECURE=true            # default: true in production, false otherwise
ALLOW_REGISTRATION=true         # new accounts are USER; admins are made with app.auth.bootstrap
# BOOTSTRAP_ADMIN_PASSWORD=     # read by: python -m app.auth.bootstrap --email you@example.org

# --- Notifications (L34) ---
# false stops the bus consumer and the delivery worker. Events still reach
# browsers over the realtime hub; nothing is persisted as a notification.
# Off is a valid deployment, not a fault.
NOTIFICATIONS_ENABLED=true
# Where the platform is reachable, for links in outbound messages. Empty means
# no link is included. Never a localhost URL in production, and never a URL
# carrying a token.
APP_BASE_URL=

# --- Email delivery (L34) ---
# Empty SMTP_HOST means the email channel reports NOT_CONFIGURED and every
# email delivery is recorded SKIPPED. That is a correctly configured platform
# that does not send email, and it is a different state from one whose provider
# broke. It also means password reset delivery stays unavailable, exactly as it
# was before L34.
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
# Never logged, never returned by an endpoint, never sent to the frontend. The
# channel's status reports whether credentials are set, never what they are.
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=notifications@localhost

# --- Discord (L35) ---
# Optional. Off by default and never required for trading: with
# DISCORD_ENABLED=false the channel reports DISABLED and any routed delivery is
# recorded SKIPPED, which is a different state from a provider that broke.
DISCORD_ENABLED=false
# A webhook, not a bot token. Create one in Discord under
# Server Settings -> Integrations -> Webhooks, and paste the URL here.
#
# SYSTEM-WIDE: one destination for the whole deployment, so every user who
# enables the Discord channel shares it. That is why it defaults to off for
# every category.
#
# NEVER commit a real value. It is a bearer credential: anyone holding it can
# post to the channel. If it leaks, delete the webhook in Discord and create a
# new one - the URL cannot be rotated in place.
DISCORD_WEBHOOK_URL=<configured-secret>
DISCORD_USERNAME=trade-research
DISCORD_TIMEOUT_SECONDS=10

# --- Monitoring (L37) ---
# false stops the collection worker. The health endpoints still answer -- they
# are L02's and probe on request -- so a deployment with monitoring off is
# observable, just not continuously.
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=15
# Freshness bar for stored market data, in seconds. Generous by default: a
# platform with no live feed is the normal state here, and crying wolf every
# fifteen seconds makes the whole dashboard ignorable.
MARKET_DATA_STALE_SECONDS=900
QUEUE_BACKLOG_WARNING=50

# --- The OMS reconcile sweep (L19) ---
# false leaves an order parked `unknown` blocked until a human posts to
# /v1/orders/{id}/reconcile. true puts the OMS's own reconciler on a loop: it
# asks the venue what it holds and records the answer, and it sends nothing.
# Default false because it decides -- an order the venue has never seen becomes
# `failed`, which is the one state a fresh order for the same intent may follow.
OMS_RECONCILE_ENABLED=false
OMS_RECONCILE_INTERVAL_SECONDS=60
OMS_RECONCILE_MAX_PER_PASS=10

# --- Recovery (L38) ---
# false skips the startup reconciliation sequence. It exists for tests and for
# a process that is deliberately not the one reconciling. A deployment that
# turns it off starts without having checked anything, and the recovery status
# says so.
RECOVERY_STARTUP_CHECKS=true

# --- Security (L39) ---
# Browser origins allowed to call the API with credentials. A wildcard, a
# `null`, or anything carrying a path is REFUSED AT STARTUP: with credentials a
# wildcard makes any website an authenticated caller, and an entry with a path
# matches nothing while looking like it works.
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Live WebSocket connections one account may hold. A browser needs one and a
# few tabs need a few; a hundred is a script. 0 disables the cap, and the
# security posture then reports it as a control that is not in force.
WS_MAX_CONNECTIONS_PER_USER=8
# Seconds a step-up re-authentication stays valid. It is single-use as well as
# time-limited, so this only has to be long enough to type a reason.
STEP_UP_TTL_SECONDS=300
# false lets the four dangerous actions (deactivate/activate a user, revoke
# sessions, exit safe mode, release a kill switch) proceed on a session cookie
# alone. It is NOT silent: the posture endpoint reports `step_up_reauth` as not
# in force and every skipped check writes a log line.
STEP_UP_REQUIRED=true

# --- The MT5 demo venue (L70b) ---
#
# Registering `mt5_demo` through POST /v1/brokers/adapters points one account at
# the real MetaTrader terminal through the existing MT5Adapter. It requires:
#
#   TRADING_MODE=demo        the route refuses a mode mismatch
#   step-up re-authentication (BROKER_CREDENTIALS scope) and a reason
#   the terminal logged in to a DEMO account -- assert_demo refuses anything
#   else, in code, before anything is stored
#
# WINDOWS ONLY. The MetaTrader5 package does not exist for Linux, so the API
# CONTAINER CANNOT USE THIS ADAPTER -- registering it there fails with 503 and
# registers nothing. To use the demo venue the API process must run on the
# Windows host that has the terminal.
#
# Where terminal64.exe lives. Empty uses the toolkit's own default, which
# `tools/mt5_paper.connect` already resolves; set it only for a non-standard
# install.
MT5_TERMINAL_PATH=

# --- Controlled live activation (L70) ---
#
# NONE of these can enable live trading, and none is a substitute for the gates
# above. `LIVE_GATES` is untouched by every one of them, so
# `live_execution_allowed` stays false whatever they say. What they do is give
# `app/live/gate.py` something to compare against -- and an unset value is a
# refusal, never a default.
#
# Check the whole set with:
#     cd backend && python -m app.live.preflight --strict
# on the WINDOWS HOST -- the API image is Linux and has no MetaTrader5 package.

# Comma-separated account identifiers approved for live trading.
# EMPTY PERMITS NOTHING. It is not a wildcard, and that asymmetry is the point:
# a deployment that forgot to configure the allowlist must trade nothing rather
# than everything.
#
# A comma-separated STRING and not a JSON list, deliberately: pydantic-settings
# parses a list field from the environment as JSON only, so the obvious spelling
# would raise SettingsError at startup -- and an allowlist that stops the process
# booting is an allowlist somebody clears to make it boot.
LIVE_ALLOWED_ACCOUNT_IDS=

# The account and server the operator approved, compared against what the
# terminal reports it is CONNECTED to. A mismatch REFUSES; it never switches
# accounts and never guesses which one was meant. Unset also refuses -- there is
# then nothing to compare against.
LIVE_EXPECTED_ACCOUNT_ID=
LIVE_EXPECTED_SERVER=

# Must be exactly YES_I_UNDERSTAND for the confirmation check to pass. A near
# miss ("yes", "YES I UNDERSTAND", a stray space) fails. Long and unpleasant to
# type by accident, which is the whole design.
ENABLE_LIVE_TRADING_CONFIRMATION=

# How old a quote may be before the live gate calls it stale. Much tighter than
# MARKET_DATA_STALE_SECONDS above, which governs the dashboard: a bar fifteen
# minutes old is fine to look at and not fine to trade on.
LIVE_QUOTE_MAX_AGE_SECONDS=60

# --- Deployment (L41) ---
# Whether THIS process runs the background workers (notification consumer,
# notification delivery, monitoring). One process must; more than one is
# duplicated work.
#
# A single-process deployment leaves it true. The production overlay runs the
# API with it FALSE and a separate worker container with it TRUE, so scaling
# the API to two replicas does not give the platform two monitoring workers.
WORKERS_ENABLED=true
# Shares the rate limiter through Redis instead of keeping it per process.
# Leave false for one process; set true the moment there are two, or each
# container will independently allow the full login rate.
RATE_LIMIT_SHARED=false

# --- Release identity (L41) ---
# Set by the BUILD, not by a running deployment. `docker build --build-arg`
# stamps them into the image; an image built without them reports
# "stamped": false on /health and is not considered deployable to production,
# because a release you cannot identify is one you cannot roll back to.
#
#   GIT_COMMIT=$(git rev-parse HEAD)
#   BUILD_TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)
#   RELEASE_VERSION=0.41.0
GIT_COMMIT=
BUILD_TIME=
RELEASE_VERSION=

# --- Production only. Required by docker-compose.prod.yml, which REFUSES to
# --- start without them rather than falling back to a development value.
# POSTGRES_USER=
# POSTGRES_PASSWORD=          # never the development 'trade'
# POSTGRES_DB=
# REDIS_PASSWORD=             # the development stack has none; production must
# TR_SERVER_NAME=trade.example.com
# TLS_CERT_DIR=/etc/letsencrypt/live/trade.example.com

# --- Research toolkit (unchanged) ---
SEC_USER_AGENT="your-project/1.0 your@email.com"
TV_WEBHOOK_SECRET=
