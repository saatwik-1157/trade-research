# Regenerable outputs. Excluded because they can carry account details:
# mt5_account.json holds a login number, server and balance, and the alert and
# paper-trade logs are a record of live activity.
data/
reports/

# Local environment
__pycache__/
*.pyc
*.pyo
.env
*.log
.venv/
venv/

# Transient test output. `backend/.pytest_*.txt` and `.err` are captured runs
# from a suite that takes 20 minutes and is chunked to survive it -- 2.3 MB of
# scrollback that describes one afternoon's state and is regenerated by running
# the suite again.
backend/.pytest_*.txt
backend/.pytest_*.err

# Build artifacts from `pip install -e ./tools` / `pip wheel ./tools`.
tools/build/

# Frozen executable. `python build_exe.py` rebuilds it; a ~200 MB binary in
# git history cannot be removed later without rewriting it.
/dist/
/build/
tools/*.egg-info/

# Session crash records. Excluded for the same reason as data/ and reports/:
# a record names the account, the balance and the log path. The directory is
# created on demand by tools/crash_report.py, so nothing needs to be tracked.
CRASH_REPORTS/

# Session logs and the detached launcher capture. The *.log rule above
# already covered the session logs; the directory also holds the launch
# capture, which is where a detached start writes a traceback it could not
# otherwise report. Same reason as data/ and reports/: a session log names
# the account and its balance.
logs/

# The operator kill switch. Its PRESENCE stops every running session, so a
# committed one would halt a fresh checkout before it started.
/STOP
