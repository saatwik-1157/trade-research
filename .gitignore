# Regenerable outputs. Excluded because they can carry account details:
# mt5_account.json holds a login number, server and balance, and the alert and
# paper-trade logs are a record of live activity.
data/
reports/

# Local environment
__pycache__/
*.pyc
*.pyo
.env
*.log
.venv/
venv/

# Transient test output. `backend/.pytest_*.txt` and `.err` are captured runs
# from a suite that takes 20 minutes and is chunked to survive it -- 2.3 MB of
# scrollback that describes one afternoon's state and is regenerated by running
# the suite again.
backend/.pytest_*.txt
backend/.pytest_*.err

# Build artifacts from `pip install -e ./tools` / `pip wheel ./tools`.
tools/build/
tools/*.egg-info/

# Session crash records. Excluded for the same reason as data/ and reports/:
# a record names the account, the balance and the log path. The directory is
# created on demand by tools/crash_report.py, so nothing needs to be tracked.
CRASH_REPORTS/
